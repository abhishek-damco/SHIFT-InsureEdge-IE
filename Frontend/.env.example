# Copy to .env.local for local development. Vite reads VITE_* variables at BUILD time,
# so every environment that runs `npm run build` (CI, Render, local) must set them.

# Google Maps Places key — powers "Google Address Search" on New Submission, Client
# Management, User Management and Distribution Management. Without it the search box
# shows "Google Places API key missing" and is disabled.
VITE_GOOGLE_MAPS_API_KEY=
