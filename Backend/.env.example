ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=insureedge_dev;Username=postgres;Password=yourpassword
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@hudsonbailey.com
SMTP_FROM_NAME=Hudson Bailey InsureEdge
SMTP_SECURE=true
APP_BASE_URL=http://localhost:5000

# Plumsail document generation (Quote Proposal Package). Get real values from
# [wherever the team keeps them, e.g. 1Password / Slack — update this line]. Leave
# blank to skip — "Download Document" will just fail with a clear config-missing error
# until these are set. Applied automatically to the product_document table on API
# startup (see Program.cs); no manual SQL needed.
PLUMSAIL_PROCESS_ID=
PLUMSAIL_USER_ID=

# Default password assigned to a Producer's linked login when it's created — lets
# them log in immediately even if the onboarding "set your password" email fails to
# send (e.g. SMTP not configured). Falls back to "Producer@123" in code if left blank.
# Change this in any non-local environment.
PRODUCER_DEFAULT_PASSWORD=

